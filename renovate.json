// SPDX-License-Identifier: MIT
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "description": "Renovate aktualisiert die Python-Dependencies (pyproject.toml + requirements*.txt), das Docker-Basisimage (nur innerhalb 3.12.x, digest-gepinnt) und die GitHub-Action-Versionen. Die Python-Version (3.12) selbst bleibt unberuehrt. Automerge ist derzeit deaktiviert - alle Updates landen als PR zur manuellen Review.",
  "enabledManagers": [
    "pep621",
    "pip_requirements",
    "dockerfile",
    "github-actions"
  ],
  "pip_requirements": {
    "fileMatch": [
      "(^|/)requirements[^/]*[.]txt$"
    ]
  },
  "packageRules": [
    {
      "description": "requires-python in pyproject.toml ist Projektkonvention (3.12) - nie automatisch anfassen.",
      "matchManagers": [
        "pep621"
      ],
      "matchPackageNames": [
        "python"
      ],
      "enabled": false
    },
    {
      "description": "Docker-Basisimage python: nur innerhalb 3.12.x aktualisieren (Patch/Minor + neuer sha256-Digest), nie auf 3.13+. Beide Namens-Varianten (python / docker.io/library/python), damit die Regel greift.",
      "matchManagers": [
        "dockerfile"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "python",
        "docker.io/library/python"
      ],
      "allowedVersions": "3.12.x",
      "pinDigests": true
    },
    {
      "description": "GitHub-Actions: python-version in setup-python (ci.yml) ist Projektkonvention (3.12) - nie automatisch anfassen. Action-Versionen (checkout, setup-python, renovatebot/github-action) duerfen normal aktualisieren.",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "python"
      ],
      "enabled": false
    },
    {
      "description": "Patch/Minor/Digest/Pin-Updates (Python-Deps, Docker 3.12.x + Digest, Action-Patches) wuerden nach gruener CI automergen; Major-Updates (z.B. checkout v4->v5, Library-Majors) bleiben PR zur manuellen Review.",
      "matchUpdateTypes": [
        "patch",
        "minor",
        "digest",
        "pin"
      ],
      "automerge": false, // set to true to enable automerge
      "automergeType": "pr",
      "platformAutomerge": true
    }
  ]
}
