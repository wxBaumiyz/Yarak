# syntax=docker/dockerfile:1
# Multi-Stage-Build: schlankes Runtime-Image auf official python:3.12-slim, non-root.
FROM docker.io/library/python:3.12-slim AS build
WORKDIR /build
COPY pyproject.toml README.md requirements.txt ./
# Dependencies hash-verifiziert aus dem Lockfile installieren (pip-compile --generate-hashes, siehe README)
RUN pip install --no-cache-dir --require-hashes --prefix=/install -r requirements.txt
COPY app ./app
RUN pip install --no-cache-dir --no-deps --prefix=/install .

FROM docker.io/library/python:3.12-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=9000
RUN useradd --create-home --uid 10001 appuser
COPY --from=build /install /usr/local
USER appuser
EXPOSE 9000
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port \"${PORT:-9000}\""]
